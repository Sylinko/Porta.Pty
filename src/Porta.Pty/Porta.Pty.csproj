<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Porta.Pty</PackageId>
    <Description>Platform-specific PTY implementations maintained for Everywhere.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- The reference assembly is added explicitly from the Windows build. -->
    <NoWarn>$(NoWarn);NU5131</NoWarn>
    <ManagedPackageArtifactsPath>$(MSBuildThisFileDirectory)../../artifacts/managed</ManagedPackageArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindows)' == 'true' AND '$(IsX64)' == 'true'">
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsWindows)' == 'true' AND '$(IsARM64)' == 'true'">
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <None Remove="NativeMethods.txt"/>
    <AdditionalFiles Include="NativeMethods.txt"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Porta.Pty.Native/Porta.Pty.Native.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- Implementations use compile-time OS switches. NuGet selects the RID asset;
       all implementations expose the API in the common reference assembly. -->
  <ItemGroup>
    <None Include="$(ManagedPackageArtifactsPath)/win/ref/Porta.Pty.dll" Pack="true" PackagePath="ref/net11.0/" />
    <None Include="$(ManagedPackageArtifactsPath)/win/Porta.Pty.dll" Pack="true" PackagePath="runtimes/win/lib/net11.0/" />
    <None Include="$(ManagedPackageArtifactsPath)/linux/Porta.Pty.dll" Pack="true" PackagePath="runtimes/linux/lib/net11.0/" />
    <None Include="$(ManagedPackageArtifactsPath)/osx/Porta.Pty.dll" Pack="true" PackagePath="runtimes/osx/lib/net11.0/" />
    <!-- ConPTY's build assets do not flow through a transitive PackageReference.
         Keep its architecture-specific hosts beside conpty.dll in consumer outputs. -->
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)/build/native/runtimes/x64/OpenConsole.exe" Pack="true" PackagePath="buildTransitive/hosts/x64/" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)/build/native/runtimes/arm64/OpenConsole.exe" Pack="true" PackagePath="buildTransitive/hosts/arm64/" />
    <None Include="buildTransitive/Porta.Pty.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
